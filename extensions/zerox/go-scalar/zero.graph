projection path:"src/main.0" text:"extern c \"abi/zerox_go.h\" as goABI\n\nfn call_go(left: i64, right: i64, label: String) -> i64 {\n    return 0_i64\n}\n\nexport c fn main() -> i32 {\n    if call_go(5000000000_i64, -11000000000_i64, \"demo\") == -6000000000_i64 {\n        return 0\n    }\n    return 1\n}\n"
